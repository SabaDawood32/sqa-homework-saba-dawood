<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- One test only, for the narrated demo recording. The full suite takes about
     two minutes, which is longer than the video is allowed to be.
     Run with:  mvn test -DsuiteFile=testng-demo.xml -->
